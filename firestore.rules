rules_version = '2';
// Mini MEP security rules. Paste into Firebase console → Firestore Database → Rules → Publish.
// Anyone can look up a game by its PIN, but nobody can list all games: the PIN is the key.
// A host can list only the games they created. Only that host can change or close a game, or remove a player.
// Each player can write only their own score document, and only while the game is open and under 24 hours old.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function game(pin) { return get(/databases/$(database)/documents/sessions/$(pin)).data; }
    function day() { return 24 * 3600 * 1000; }
    // Games made before expiresAt existed have none; the game treats them as closed anyway
    function live(g) { return g.status != 'closed' && request.time.toMillis() < g.get('expiresAt', 9999999999999); }

    match /sessions/{pin} {
      allow get: if true;
      allow list: if signedIn() && resource.data.hostUid == request.auth.uid;
      allow create: if signedIn()
        && pin.matches('^[0-9]{6}$')
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.mode in ['live', 'open']
        && request.resource.data.status in ['lobby', 'playing']
        && request.resource.data.seed is int
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt <= request.time.toMillis() + day() + 600000;
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.seed == resource.data.seed
        && request.resource.data.get('expiresAt', 0) == resource.data.get('expiresAt', 0)
        && request.resource.data.status in ['lobby', 'playing', 'closed'];
      allow delete: if false;

      match /players/{playerId} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.auth.uid == playerId
          && live(game(pin))
          && request.resource.data.nick is string
          && request.resource.data.nick.size() >= 2
          && request.resource.data.nick.size() <= 16
          && (!('runs' in request.resource.data) || request.resource.data.runs.size() <= 20);
        allow delete: if signedIn() && game(pin).hostUid == request.auth.uid;
      }
    }
  }
}
